# Copy to .env and fill in ONE of these. .env is gitignored.
#   cp .env.example .env
# scripts/run.sh loads .env automatically if present.

# If you have OpenAI credits:
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o          # override after checking: python -m backend.vision_providers

# Free, no credit card (aistudio.google.com):
# GEMINI_API_KEY=...

# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# Force a provider when several keys are set:
# VISION_PROVIDER=openai
